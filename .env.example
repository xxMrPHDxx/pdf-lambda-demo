# --- API ---
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- AWS / LocalStack ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
AUTO_PROVISION=true

# --- Resources ---
S3_BUCKET=pdf-demo
DDB_TABLE=pdf-demo
SQS_BATCH_QUEUE=http://localhost:4566/000000000000/pdf-demo-batches
SQS_FINALIZE_QUEUE=http://localhost:4566/000000000000/pdf-demo-finalize
REDIS_URL=redis://localhost:6379

# --- Tuning ---
BATCH_SIZE=4
MAX_RUNNING_JOBS=10
MAX_CLIENT_RUNNING_JOBS=2
PDF_RENDER_DELAY_MS=150
PDF_CACHE_DAYS=7
ZIP_CACHE_HOURS=3
WORKER_CONCURRENCY=5

# --- Email ---
SES_FROM=orders@pdfdemo.local
SES_SAVE_TO_S3=true
PRESIGN_EXPIRES_SECONDS=604800
PORTAL_URL=http://localhost:8080
